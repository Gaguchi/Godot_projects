{
  "name": "phaser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "typecheck:cli": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint src",
    "lint:content": "tsx scripts/lint-content.ts",
    "verify": "npm run typecheck && npm run typecheck:cli && npm run lint:content && npm run check-context-doc && npm test",
    "cli": "tsx scripts/cli/play.ts",
    "sim": "tsx scripts/cli/play.ts combat --autobattle",
    "bake-sprites": "tsx scripts/cli/bake-sprites.ts",
    "bake-board-sprites": "tsx scripts/cli/bake-board-sprites.ts",
    "map-tool": "tsx scripts/cli/map-tool.ts",
    "gen-mage": "tsx scripts/cli/gen-mage.ts",
    "gen-variants": "tsx scripts/cli/gen-variants.ts",
    "sprite-lab": "tsx scripts/cli/sprite-lab.ts",
    "comfy": "tsx scripts/cli/comfy-gen.ts",
    "cut-tiles": "tsx scripts/cli/cut-tiles.ts",
    "check-context-doc": "tsx scripts/check-context-doc.ts",
    "perf-gates": "node scripts/measure-bundle.mjs",
    "app": "electron electron/main.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tile-demo": "tsx scripts/cli/tile-demo.ts"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "howler": "^2.2.4",
    "phaser": "^4.1.0",
    "react": "^19.2.5",
    "react-aria": "^3.48.0",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-onboarding": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.12.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^2.1.9",
    "electron": "^42.3.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.3.6",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^2.1.9"
  }
}
