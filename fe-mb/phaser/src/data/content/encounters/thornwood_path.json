    {
      "id": "ambush_toll",
      "weight": 4,
      "oneShot": false,
      "conditions": [],
      "outcome": {
        "kind": "checkEvent",
        "event": {
          "id": "ambush_toll",
          "title": "Rope snaps taut across the path \u2014 an ambush.",
          "description": "Figures drop from the branches, daggers already out. \"Thirty gold,\" one hisses through a cloth mask, \"and you keep your blood.\"",
          "choices": [
            {
              "id": "pay_toll",
              "text": "Pay the toll. 30 gold.",
              "check": {
                "kind": "gold",
                "amount": 30
              },
              "onPass": {
                "narration": "Coin changes hands. The ropes go slack and the trees swallow them whole, as if they were never there.",
                "effects": [
                  {
                    "kind": "addGold",
                    "amount": -30
                  }
                ]
              },
              "onFail": {
                "narration": "Your purse is too light, and they take that personally.",
                "effects": [
                  {
                    "kind": "startCombat",
                    "enemyGroupId": "thornwood_ambush"
                  }
                ]
              }
            },
            {
              "id": "fight",
              "text": "Draw steel.",
              "onPass": {
                "narration": "\"Wrong answer,\" the masked one sighs \u2014 and the thicket comes alive.",
                "effects": [
                  {
                    "kind": "startCombat",
                    "enemyGroupId": "thornwood_ambush"
                  }
                ]
              }
            },
            {
              "id": "slip_away",
              "text": "Scatter into the underbrush.",
              "check": {
                "kind": "stat",
                "stat": "spd",
                "threshold": 8
              },
              "onPass": {
                "narration": "You break formation and melt into the thicket before they can close the net. Their curses fade behind you.",
                "effects": []
              },
              "onFail": {
                "narration": "A tripline catches an ankle. By the time you're up, they're on you.",
                "effects": [
                  {
                    "kind": "startCombat",
                    "enemyGroupId": "thornwood_ambush"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "thieves_crossroads",
      "weight": 3,
      "oneShot": true,
      "conditions": [],
      "outcome": {
        "kind": "checkEvent",
        "event": {
          "id": "thieves_crossroads",
          "title": "Carved marks scar the crossroads post \u2014 thieves' cant.",
          "description": "Somebody left instructions here for those who can read them. A shadow shifts at the treeline, watching to see what you do.",
          "choices": [
            {
              "id": "old_signs",
              "text": "Answer with the old signs.",
              "check": {
                "kind": "class",
                "classId": "thief"
              },
              "onPass": {
                "narration": "The shadow steps out grinning, clasps arms with your thief, and presses a share of last week's take into their hands. \"For keeping the cant alive.\"",
                "effects": [
                  {
                    "kind": "addGold",
                    "amount": 60
                  }
                ]
              },
              "onFail": {
                "narration": "Nobody in your company knows the signs. You fumble a guess \u2014 and pay for the insult when a sling stone takes your coin pouch clean off its cord.",
                "effects": [
                  {
                    "kind": "addGold",
                    "amount": -20
                  }
                ]
              }
            },
            {
              "id": "knife_game",
              "text": "Play their game of knives.",
              "check": {
                "kind": "stat",
                "stat": "skl",
                "threshold": 8
              },
              "onPass": {
                "narration": "Five throws, five hits. The watcher whistles low and tosses you the stake purse before vanishing into the trees.",
                "effects": [
                  {
                    "kind": "addGold",
                    "amount": 40
                  }
                ]
              },
              "onFail": {
                "narration": "Your third throw goes wide. The stake purse \u2014 with your coin in it \u2014 disappears into the canopy with a laugh.",
                "effects": [
                  {
                    "kind": "addGold",
                    "amount": -25
                  }
                ]
              }
            },
            {
              "id": "pass_by",
              "text": "Keep to the road.",
              "onPass": {
                "narration": "You leave the post and its marks behind. The shadow loses interest.",
                "effects": []
              }
            }
          ]
        }
      }
    },
    {
      "id": "thornwood_bridge_crossing",
      "weight": 4,
      "oneShot": true,
      "conditions": [],
      "outcome": {
        "kind": "checkEvent",
        "event": {
          "id": "bridge_crossing",
          "title": "An old rope bridge sways across a ravine.",
          "description": "The shortcut saves a day's travel, but the planks are rotten and the wind is up.",
          "choices": [
            {
              "id": "cross_carefully",
              "text": "Send the most agile across first to scout.",
              "check": {
                "kind": "stat",
                "stat": "spd",
                "threshold": 8
              },
              "onPass": {
                "narration": "The lead scout makes it. The party crosses with whispered footing. You save a day.",
                "effects": [
                  {
                    "kind": "addFood",
                    "amount": 2
                  }
                ]
              },
              "onFail": {
                "narration": "A plank gives way mid-cross. You haul them up, but the party loses a day backtracking.",
                "effects": [
                  {
                    "kind": "addFood",
                    "amount": -1
                  }
                ]
              }
            },
            {
              "id": "take_long_way",
              "text": "Go the long way around. Safer.",
              "onPass": {
                "narration": "You take the road. Slow. Safe. No surprises.",
                "effects": []
              }
            }
          ]
        }
      }
    },
