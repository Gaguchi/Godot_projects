    {
      "id": "wandering_blacksmith",
      "weight": 4,
      "oneShot": false,
      "conditions": [],
      "outcome": {
        "kind": "checkEvent",
        "event": {
          "id": "wandering_blacksmith",
          "title": "A wandering blacksmith hails you from his cart.",
          "description": "His portable forge still glows in its iron cradle. \"Road's been cruel to your kit, by the look of it. Sixty gold and I'll set it all right \u2014 dents hammered, edges honed, straps mended.\"",
          "choices": [
            {
              "id": "pay_for_work",
              "text": "Pay 60 gold for his best work.",
              "check": {
                "kind": "gold",
                "amount": 60
              },
              "onPass": {
                "narration": "He works through the afternoon, humming over the anvil. Your gear sits better than it has in weeks, and the party's aches fade with the load off their shoulders.",
                "effects": [
                  {
                    "kind": "addGold",
                    "amount": -60
                  },
                  {
                    "kind": "healParty",
                    "percent": 0.3
                  },
                  {
                    "kind": "setFlag",
                    "key": "blacksmith_patronized",
                    "value": true,
                    "scope": "run"
                  }
                ]
              },
              "onFail": {
                "narration": "Your purse comes up short. He shrugs, not unkindly, and stokes his forge for the next traveler.",
                "effects": []
              }
            },
            {
              "id": "trade_stories",
              "text": "Trade stories of the road instead.",
              "check": {
                "kind": "stat",
                "stat": "lck",
                "threshold": 5
              },
              "onPass": {
                "narration": "He laughs at your best tale and shares his supper \u2014 good bread, better sausage. \"For the company,\" he says.",
                "effects": [
                  {
                    "kind": "addFood",
                    "amount": 1
                  }
                ]
              },
              "onFail": {
                "narration": "He listens politely, then returns to his bellows. The road calls you both onward.",
                "effects": []
              }
            },
            {
              "id": "walk_on",
              "text": "Walk on.",
              "onPass": {
                "narration": "You nod to him and keep moving. The ring of his hammer follows you down the road.",
                "effects": []
              }
            }
          ]
        }
      }
    },
    {
      "id": "injured_knight",
      "weight": 3,
      "oneShot": true,
      "conditions": [],
      "outcome": {
        "kind": "checkEvent",
        "event": {
          "id": "injured_knight",
          "title": "An injured knight slumps against a milestone.",
          "description": "His shield arm is bound in bloody rags and his horse is nowhere in sight. \"Bandits,\" he rasps. \"A meal and I might live to repay you.\"",
          "choices": [
            {
              "id": "help_him",
              "text": "Spend a ration to feed him and bind his wounds.",
              "check": {
                "kind": "food",
                "amount": 1
              },
              "onPass": {
                "narration": "He eats like a man back from the dead. When he can stand, he presses his purse into your hands and swears his sword to your cause, once his arm mends. \"Look for me on the road ahead.\"",
                "effects": [
                  {
                    "kind": "addFood",
                    "amount": -1
                  },
                  {
                    "kind": "addGold",
                    "amount": 40
                  },
                  {
                    "kind": "setFlag",
                    "key": "injured_knight_helped",
                    "value": true,
                    "scope": "permanent"
                  }
                ]
              },
              "onFail": {
                "narration": "You have nothing to spare. He nods, understanding, and waves you on before his eyes close.",
                "effects": []
              }
            },
            {
              "id": "loot_him",
              "text": "Strip his gear and leave him.",
              "onPass": {
                "narration": "His sword and pauldrons fetch a fair price in your pack. He watches you take them, too weak to curse.",
                "effects": [
                  {
                    "kind": "addGold",
                    "amount": 25
                  },
                  {
                    "kind": "setFlag",
                    "key": "injured_knight_looted",
                    "value": true,
                    "scope": "permanent"
                  }
                ]
              }
            },
            {
              "id": "ride_past",
              "text": "Ride past.",
              "onPass": {
                "narration": "The road is full of dying men. You do not look back.",
                "effects": []
              }
            }
          ]
        }
      }
    },
