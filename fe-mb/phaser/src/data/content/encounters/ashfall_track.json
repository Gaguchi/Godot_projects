                  { "kind": "damageParty", "amount": 3 },
                  { "kind": "addFood", "amount": 3 },
                  { "kind": "setFlag", "key": "ancient_shrine_blessed", "value": true, "scope": "permanent" }
                ]
              }
            },
            {
              "id": "search_offerings",
              "text": "Search for old offerings.",
              "check": { "kind": "stat", "stat": "lck", "threshold": 6 },
              "onPass": {
                "narration": "Under a cracked slab you find coins fused by ancient heat — but still gold.",
                "effects": [{ "kind": "addGold", "amount": 35 }]
              },
              "onFail": {
                "narration": "Ash and dust. The shrine's silence feels pointed.",
                "effects": []
              }
            },
            {
